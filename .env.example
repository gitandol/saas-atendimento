DJANGO_SETTINGS_MODULE=config.settings.desenvolvimento
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# Mantenha esta chave estavel; rotacione somente com recriptografia das credenciais.
IA_CHAVE_CRIPTOGRAFIA=troque-por-outro-segredo-longo-e-aleatorio
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO
POSTGRES_DB=atendimento
POSTGRES_USER=atendimento
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
# Evolution API local gerenciada pelo Docker Compose.
EVOLUTION_API_KEY=troque-por-uma-chave-longa-e-aleatoria
EVOLUTION_LOG_LEVEL=ERROR,WARN
# Como estes valores compoem uma URI, use somente A-Z, a-z, 0-9, _ e -.
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=troque-esta-senha
EVOLUTION_INTERNAL_URL=http://evolution:8080
EVOLUTION_WEBHOOK_BASE_URL=http://web:8000
WHATSAPP_HOSTS_INTERNOS_PERMITIDOS=evolution
